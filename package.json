{
  "name": "raillab-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive incident playground for RailLab: runs the real scenario engine and reference clients in the browser.",
  "license": "MIT",
  "author": "Anas Abubakar",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stamp": "node scripts/stamp-engine.mjs"
  },
  "dependencies": {
    "@anasabubakar/raillab-engine": "file:vendor/anasabubakar-raillab-engine-0.1.0.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
